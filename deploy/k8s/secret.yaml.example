# =============================================================================
# deploy/k8s/secret.yaml.example — the Secret the pod reads, as a template
# =============================================================================
#
# Not applied by `kubectl apply -f deploy/k8s/`: kubectl reads .yaml, .yml and
# .json from a directory, and this file is none of them.
#
# Two ways to create the Secret. Use one:
#
#   1. From your .env (one source for compose and Kubernetes):
#        kubectl -n vigil-sre create secret generic vigil-sre-env --from-env-file=.env
#
#   2. From this template, for setups without a .env (GitOps, sealed-secrets):
#        cp deploy/k8s/secret.yaml.example deploy/k8s/secret.yaml   # ignored by git
#        # fill in the values, then:
#        kubectl apply -f deploy/k8s/secret.yaml
#
# The keys are exactly those in .env.example; tests/test_k8s_manifests.py fails
# when the two lists differ, and when a value here is not empty.
#
# Leaving every channel empty is allowed, and not silent: each round logs
# "No alert channels configured", and an alert that reaches nobody makes the
# round exit 1, which puts the pod into CrashLoopBackOff until a channel exists.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: vigil-sre-env
  namespace: vigil-sre
type: Opaque
stringData:
  DISCORD_WEBHOOK_URL: ""
  SLACK_WEBHOOK_URL: ""
  # A dead man's switch ping URL (healthchecks.io or similar). Empty: each
  # round warns that nothing is watching the monitor.
  HEARTBEAT_URL: ""
  # Required for the dashboard editor and targetctl to change the target list.
  API_WRITE_TOKEN: ""
  # An example name: any ${VAR} a target's expect_substring uses goes here. A
  # target that references an empty or missing one is refused with a message.
  HEALTH_TOKEN: ""
  # Not a secret, kept with the rest of the environment.
  HISTORY_RETENTION_DAYS: "30"
